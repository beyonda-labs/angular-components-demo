{
    "name": "angular-components-demo",
    "version": "1.1.0",
    "packageManager": "pnpm@10.34.5",
    "scripts": {
        "build": "ng build",
        "check-dependencies": "node scripts/check-dependencies.js",
        "check-translations": "node scripts/check-translations.js",
        "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\"",
        "install:local": "node scripts/switch-dependencies.js local",
        "install:remote": "node scripts/switch-dependencies.js remote",
        "lib:refresh": "pnpm install",
        "lint": "ng lint && pnpm run typecheck && pnpm run check-translations && pnpm run check-dependencies",
        "lint:fix": "ng lint --fix",
        "merge-translations": "pnpm run check-translations && node scripts/merge-translations.js",
        "prebuild": "pnpm run merge-translations",
        "prepare": "husky",
        "sort-translations": "node scripts/sort-translations.js",
        "start": "node ./scripts/serve-watch-libs.js",
        "test": "jest",
        "test:ci": "jest --ci",
        "test:watch": "jest --watch",
        "typecheck": "tsc -p tsconfig.spec.json --noEmit",
        "verify": "pnpm run lint && pnpm run format:check && pnpm run test:ci",
        "watch": "ng build --watch --configuration development"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "19.2.17",
        "@angular/common": "19.2.17",
        "@angular/compiler": "19.2.17",
        "@angular/core": "19.2.17",
        "@angular/forms": "19.2.17",
        "@angular/platform-browser": "19.2.17",
        "@angular/platform-browser-dynamic": "19.2.17",
        "@angular/router": "19.2.17",
        "@beyonda-labs/angular-components": "1.2.0",
        "@fortawesome/angular-fontawesome": "1.0.0",
        "@fortawesome/fontawesome-svg-core": "6.7.1",
        "@fortawesome/free-brands-svg-icons": "6.7.1",
        "@fortawesome/free-regular-svg-icons": "6.7.1",
        "@fortawesome/free-solid-svg-icons": "6.7.1",
        "@interactjs/types": "1.10.27",
        "@ngx-translate/core": "16.0.4",
        "@ngx-translate/http-loader": "16.0.1",
        "bootstrap": "5.3.8",
        "interactjs": "1.10.27",
        "monaco-editor": "0.52.2",
        "ngx-bootstrap": "19.0.2",
        "ngx-extended-pdf-viewer": "28.1.0",
        "ngx-monaco-editor-v2": "19.0.2",
        "ngx-toastr": "19.0.0",
        "rxjs": "7.8.2",
        "tslib": "2.7.0",
        "uuid": "11.1.0",
        "zone.js": "0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "19.2.19",
        "@angular-eslint/builder": "19.8.1",
        "@angular/cli": "19.2.19",
        "@angular/compiler-cli": "19.2.17",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin-js": "2.13.0",
        "@types/jest": "29.5.14",
        "angular-eslint": "19.8.1",
        "chokidar": "4.0.3",
        "eslint": "9.39.5",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "eslint-plugin-unicorn": "56.0.1",
        "husky": "9.1.7",
        "jest": "29.7.0",
        "jest-preset-angular": "14.6.2",
        "lint-staged": "17.5.1",
        "prettier": "3.3.3",
        "prettier-plugin-organize-attributes": "1.0.0",
        "ts-node": "10.9.2",
        "typescript": "5.5.4",
        "typescript-eslint": "8.70.1"
    }
}
